---
import BackToTop from "@components/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import SearchModal from "@components/SearchModal.astro";
import { getPageOg } from "@lib/og";
import { UI } from "@lib/ui";

type Props = {
    title: string;
    description: string;
    ogImage?: string;
    ogImageAlt?: string;
    lang?: string;
    ogType?: "website" | "article";
    publishedTime?: string | Date;
    locale?: string;
};

const {
    title,
    description,
    ogImage = getPageOg("home").ogImage,
    ogImageAlt = getPageOg("home").ogImageAlt,
    lang = "en",
    ogType,
    publishedTime,
    locale = toOpenGraphLocale(lang),
} = Astro.props;

function toOpenGraphLocale(language: string): string {
    const normalizedLanguage = language.toLowerCase();
    if (normalizedLanguage.startsWith("zh")) return "zh_CN";
    if (normalizedLanguage.startsWith("ja")) return "ja_JP";
    return "en_US";
}
---

<!doctype html>
<html lang={lang}>
    <head>
        <Head
            title={title}
            description={description}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            ogType={ogType}
            publishedTime={publishedTime}
            locale={locale}
        />
        <slot name="head" />
    </head>
    <body>
        <a lang="en" href="#main-content" class="skip-link">{UI.skip}</a>
        <Header />
        <div class="site-edge-fade site-edge-fade--top" aria-hidden="true"></div>
        <div class="site-edge-fade site-edge-fade--bottom" aria-hidden="true"></div>
        <main id="main-content" tabindex="-1"><slot /></main>
        <SearchModal />
        <Footer />
        <BackToTop />
    </body>
</html>
