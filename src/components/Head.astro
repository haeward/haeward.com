---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE, SOCIALS } from "@consts";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    ogImageType?: string;
    ogType?: "website" | "article";
    publishedTime?: string | Date;
    locale?: string;
}

const path = Astro.url.pathname;
const canonicalURL = new URL(
    path.endsWith("/") || /\.[a-z0-9]+$/i.test(path) ? path : `${path}/`,
    Astro.site,
);
const notFound = path === "/404" || path === "/404/" || path === "/404.html";
const {
    title,
    description,
    ogImage,
    ogImageAlt = `${title} preview image`,
    ogImageWidth = 1200,
    ogImageHeight = 630,
    ogImageType = "image/png",
    ogType = "website",
    publishedTime,
    locale = "en_US",
} = Astro.props;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
const ogImageWidthContent = String(ogImageWidth);
const ogImageHeightContent = String(ogImageHeight);
const publishedTimeContent =
    publishedTime instanceof Date ? publishedTime.toISOString() : publishedTime;
const twitterSite = getTwitterSite();

function getTwitterSite(): string | undefined {
    const twitter = SOCIALS.find((social) => social.NAME === "Twitter" && social.ENABLE !== false);
    if (!twitter) return undefined;

    try {
        const username = new URL(twitter.HREF).pathname.split("/").filter(Boolean)[0];
        return username ? `@${username}` : undefined;
    } catch {
        return undefined;
    }
}
---

<!-- Global Metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/site/favicon-32.png">
<meta name="generator" content={Astro.generator}>

<!-- Canonical URL -->
{!notFound && <link rel="canonical" href={canonicalURL} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title}>
<meta name="description" content={description}>
{notFound && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:site_name" content={SITE.NAME}>
<meta property="og:locale" content={locale}>
{ogImageURL && (
        <>
            <meta property="og:image" content={ogImageURL} />
            <meta property="og:image:width" content={ogImageWidthContent} />
            <meta property="og:image:height" content={ogImageHeightContent} />
            <meta property="og:image:type" content={ogImageType} />
            <meta property="og:image:alt" content={ogImageAlt} />
        </>
    )}
{publishedTimeContent && <meta property="article:published_time" content={publishedTimeContent} />}

<!-- Twitter -->
<meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"}>
<meta name="twitter:url" content={canonicalURL}>
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
{ogImageURL && <meta name="twitter:image:alt" content={ogImageAlt} />}

<!-- Mastodon -->
<link rel="me" href="https://g0v.social/@haeward">
<meta name="fediverse:creator" content="@haeward@g0v.social">

<!-- RSS Link -->
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.NAME}
    href={new URL("rss.xml", Astro.site)}
>

<ClientRouter />

<script is:inline>
(() => {
    let theme =
        window.__siteState?.theme ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") theme = stored;
    } catch {
        /* Storage is optional. */
    }
    document.documentElement.dataset.themeMode = theme;
    document.documentElement.classList.toggle("dark", theme === "dark");
})();
</script>

<script>
import "../scripts/site";
</script>
