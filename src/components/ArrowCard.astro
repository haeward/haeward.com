---
import type { CollectionEntry } from "astro:content";

type CardVariant = "home" | "archive";

type Props = {
    entry: CollectionEntry<"blog">;
    variant?: CardVariant;
};

const { entry, variant = "archive" } = Astro.props;

const isHome = variant === "home";
const formattedDate = new Intl.DateTimeFormat(
    "en-US",
    isHome
        ? {
              year: "numeric",
              timeZone: "UTC",
              month: "short",
              day: "numeric",
          }
        : {
              timeZone: "UTC",
              month: "short",
              day: "numeric",
          },
).format(entry.data.date);

const cardClasses =
    "group grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 rounded-sm px-0 py-3 transition-colors duration-200 ease-out sm:gap-x-4";
const titleClasses =
    "post-row-title transition-colors duration-200 group-hover:text-[var(--site-color-text-neutral-hover)]";
const dateWidthClasses = isHome ? "w-[6.5rem]" : "w-[3.6rem]";
const dateClasses = "post-row-date text-left font-normal tabular-nums";
---

<a href={`/posts/${entry.id}/`} class={cardClasses}>
    <time
        class:list={[dateWidthClasses, dateClasses, "whitespace-nowrap"]}
        datetime={entry.data.date.toISOString()}
    >
        {formattedDate}
    </time>
    <div class="min-w-0">
        <div
            class:list={[titleClasses, "underline-offset-4 group-hover:underline group-focus-visible:underline"]}
        >
            {entry.data.title}
        </div>
    </div>
</a>
