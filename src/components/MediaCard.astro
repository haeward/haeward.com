---
import type { ClientMediaItem } from "@lib/media";
import { MEDIA_CARD_CLASSES, MEDIA_CARD_TITLE_CLAMP, renderMediaStars } from "@lib/media-card";

interface Props {
    item: ClientMediaItem;
}

const { item } = Astro.props;
const stars = Math.max(0, Math.min(5, Math.round(item.myRating ?? 0)));
const CardTag = item.url ? "a" : "div";
const cardAttributes = item.url
    ? { href: item.url, target: "_blank", rel: "noopener noreferrer" }
    : {};
const cardClass = item.url ? MEDIA_CARD_CLASSES.linked : MEDIA_CARD_CLASSES.static;
---

<li class="group h-full">
    <CardTag {...cardAttributes} class={cardClass}>
        <div class="flex h-full flex-col">
            <div class={MEDIA_CARD_CLASSES.coverShell}>
                {item.cover ? (
                    <img
                        src={item.cover}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        width="240"
                        height="360"
                        class={MEDIA_CARD_CLASSES.coverImage}
                    />
                ) : (
                    <div class={MEDIA_CARD_CLASSES.missingCover}>No cover</div>
                )}
            </div>
            <div class={MEDIA_CARD_CLASSES.content}>
                <div class={MEDIA_CARD_CLASSES.title} style={MEDIA_CARD_TITLE_CLAMP}>
                    {item.title}
                </div>
                <div class={MEDIA_CARD_CLASSES.stars}>
                    <Fragment set:html={renderMediaStars(stars)} />
                    <span class="sr-only">{stars} out of 5</span>
                </div>
            </div>
        </div>
    </CardTag>
</li>
