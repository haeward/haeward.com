---
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import { BLOG, SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getPublishedPosts, groupPostsByYear } from "@lib/posts";

const posts = groupPostsByYear(await getPublishedPosts());
const years = Object.keys(posts).sort((a, b) => Number.parseInt(b, 10) - Number.parseInt(a, 10));
---

<PageLayout title={`${BLOG.TITLE} | ${SITE.NAME}`} description={BLOG.DESCRIPTION} lang="en">
    <Container>
        <h1 class="sr-only">Archive</h1>
        <div class="page-sections">
            {years.map((year) => (
                <section class="space-y-4 sm:space-y-5" aria-labelledby={`archive-year-${year}`}>
                    <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-[var(--site-color-surface-border-strong)] pb-4 sm:pb-5">
                        <h2 id={`archive-year-${year}`} class="section-title">
                            {year}
                        </h2>
                        <p class="text-right text-sm tabular-nums text-[var(--site-color-text-muted)] sm:text-[0.9375rem]">
                            {posts[year].length.toLocaleString("en-US")} {posts[year].length === 1 ? "post" : "posts"}
                        </p>
                    </div>
                    <ul class="flex flex-col gap-1 ps-2 sm:ps-4">
                        {posts[year].map((post) => (
                            <li>
                                <ArrowCard entry={post} variant="archive" />
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
        </div>
    </Container>
</PageLayout>
