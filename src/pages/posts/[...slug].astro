---
import { render } from "astro:content";
import ImageLightbox from "@components/ImageLightbox.astro";
import LinkEnhancer from "@components/LinkEnhancer.astro";
import PostHeader from "@components/PostHeader.astro";
import PostReplies from "@components/PostReplies.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getPostOg } from "@lib/og";
import type { BlogPost } from "@lib/posts";
import { getPublishedPosts } from "@lib/posts";

export async function getStaticPaths() {
    const posts = await getPublishedPosts();

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

type Props = {
    post: BlogPost;
};

const { post } = Astro.props;
const { Content, headings } = await render(post);
const postBody = post.rendered?.html ?? "";
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const hasToc = tocHeadings.length > 0;
const postOg = getPostOg(post);
---

<PageLayout
    title={`${post.data.title} | ${SITE.NAME}`}
    description={post.data.description}
    ogImage={postOg.ogImage}
    ogImageAlt={postOg.ogImageAlt}
    lang={post.data.lang}
    ogType="article"
    publishedTime={post.data.date}
>
    <Fragment slot="head">
        {postBody.includes("https://webp.haeward.com/") && (
            <link rel="preconnect" href="https://webp.haeward.com" />
        )}
    </Fragment>
    <div class="px-5">
        <div class="blog-post-shell">
            <div class="blog-post-main">
                <PostHeader post={post} body={postBody} />

                {hasToc && <TableOfContents lang={post.data.lang} headings={tocHeadings} variant="mobile" />}

                <article
                    class="animate blog-article serif-reading-surface site-prose-links"
                    data-pagefind-body
                >
                    <Content />
                </article>

                <PostReplies title={post.data.title} mastodonUrl={post.data.mastodonUrl} />
            </div>

            {hasToc && (
                <div class="blog-post-toc-rail">
                    <TableOfContents lang={post.data.lang} headings={tocHeadings} />
                </div>
            )}
        </div>
    </div>

    <LinkEnhancer />
    <ImageLightbox lang={post.data.lang} />
</PageLayout>
