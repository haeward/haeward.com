---
import Container from "@components/Container.astro";
import LinkEnhancer from "@components/LinkEnhancer.astro";
import { ABOUT, SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getPageOg } from "@lib/og";
import { Content as AboutContent } from "../content/about.md";

const pageOg = getPageOg("about");
---

<PageLayout
    title={`${ABOUT.TITLE} | ${SITE.NAME}`}
    description={ABOUT.DESCRIPTION}
    ogImage={pageOg.ogImage}
    ogImageAlt={pageOg.ogImageAlt}
    lang="zh-CN"
>
    <Container>
        <section class="about-page space-y-6 sm:space-y-8">
            <div class="animate max-w-2xl space-y-3">
                <h1 class="page-title">About</h1>
            </div>

            <article
                class="animate about-content serif-reading-surface site-prose-links prose dark:prose-invert max-w-none"
            >
                <AboutContent />
            </article>
        </section>
    </Container>

    <LinkEnhancer />
</PageLayout>
