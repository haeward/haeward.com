---
import { Image } from "astro:assets";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getPageOg } from "@lib/og";
import { getPublishedPosts } from "@lib/posts";
import homeIllustration from "../../public/assets/images/site/home-hover-runtime.webp";

const blog = (await getPublishedPosts()).slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const pageOg = getPageOg("home");
---

<PageLayout
    title={SITE.NAME}
    description={SITE.DESC}
    ogImage={pageOg.ogImage}
    ogImageAlt={pageOg.ogImageAlt}
    lang="en"
>
    <Container>
        <div class="page-sections">
            <section>
                <div class="flex justify-center items-center mb-4">
                    <div class="relative w-36 h-36">
                        <Image
                            src={homeIllustration}
                            alt="programmer"
                            class="w-full h-full animate"
                            width={144}
                            height={144}
                            widths={[144, 288, homeIllustration.width]}
                            sizes="144px"
                            quality={80}
                            loading="eager"
                        />
                    </div>
                </div>
                <div class="flex justify-center animate gap-0 min-[360px]:gap-1 mb-4">
                    {SOCIALS.filter(social => social.ENABLE !== false).map((social) => (
            <a
              href={social.HREF}
              data-astro-prefetch={social.NAME === "RSS" ? "false" : undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-11 shrink-0 items-center justify-center hover:text-[var(--site-color-text-neutral-hover)] transition-colors duration-300"
              aria-label={`${social.NAME} (opens in a new tab)`}
              data-new-window
            >
              <Image
                src={social.ICON}
                alt={social.NAME}
                class="home-social-icon w-6 h-6"
                width={28}
                height={28}
                loading="eager"
              />
            </a>
          ))}
                </div>
            </section>

            <section class="animate">
                <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
                    <h1 class="section-title">Latest posts</h1>
                    <a href="/posts/" class="site-link underline text-sm">All posts</a>
                </div>
                <ul class="flex flex-col gap-1 ps-2 sm:ps-4">
                    {blog.map(post => (
            <li>
              <ArrowCard entry={post} variant="home" />
            </li>
          ))}
                </ul>
            </section>
        </div>
    </Container>
</PageLayout>
